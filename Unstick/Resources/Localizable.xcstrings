    "onboarding.logoTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UNSTICK"
          }
        },
        "ru" : {
          "stringUnit" : {
